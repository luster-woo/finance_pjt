# .env.prod 로 복사해서 채운다. .env.prod 는 커밋하지 않는다.

# Django
# SECRET_KEY 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False

# 접속할 도메인 또는 공인 IP (쉼표 구분)
ALLOWED_HOSTS=
# admin 로그인용. 스킴 포함.
CSRF_TRUSTED_ORIGINS=
# 인증서를 붙인 뒤에 True
SECURE_SSL_REDIRECT=False
CORS_ALLOWED_ORIGINS=

# PostgreSQL (비어 있으면 SQLite 로 동작)
POSTGRES_DB=finfit
POSTGRES_USER=finfit
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 외부 데이터 API
FINLIFE_API_KEY=
STOCK_API_KEY=
NEWS_API_KEY=

# GMS / AI 추천
GMS_API_KEY=
GMS_MODEL=
GMS_API_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions

# GMS 장애 시 폴백
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 카카오
KAKAO_REST_API_KEY=

# Vite (VITE_API_BASE_URL 은 compose 에서 /api 로 고정)
VITE_KAKAO_MAP_KEY=
