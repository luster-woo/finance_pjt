# ── Django (BE) ───────────────────────────────────────────────
# 배포 시 반드시 강력한 랜덤 값으로 교체하세요
SECRET_KEY=your-secret-key-here
DEBUG=True

# 배포 환경에서 허용할 호스트 (쉼표 구분). 개발 시 비워두면 localhost만 허용
ALLOWED_HOSTS=

# ── 외부 데이터 API ───────────────────────────────────────────
# FSS 금융상품통합비교공시 API — https://finlife.fss.or.kr
FINLIFE_API_KEY=

# 한국투자증권 오픈API (주식 데이터 보조용)
STOCK_API_KEY=

# 뉴스 API 키 (현재 RSS 방식으로 대체되어 미사용)
NEWS_API_KEY=

# ── GMS / AI 추천 API ─────────────────────────────────────────
# SSAFY GMS (OpenAI 호환) — https://gms.ssafy.io
GMS_API_KEY=
GMS_MODEL=claude-opus-4-8
GMS_API_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions

# Google Gemini (GMS 장애 시 폴백)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── 카카오 API ────────────────────────────────────────────────
# Kakao Developers — https://developers.kakao.com
KAKAO_REST_API_KEY=

# ── Vite (FE) ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_KAKAO_MAP_KEY=
